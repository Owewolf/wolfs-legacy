PORT=4444
# Optional bind address. Use 127.0.0.1 behind a local reverse proxy.
LISTEN_HOST=0.0.0.0

# Leave as 'auto' to generate and persist secrets automatically on first run.
# Or set your own values (JWT_SECRET: any string 32+ chars, ENCRYPTION_KEY: 64-char hex).
JWT_SECRET=auto
ENCRYPTION_KEY=auto

# Independent managed copies; choose a VERIFIED non-bind-mounted directory
DOCUMENT_STORAGE_ROOT=/srv/data/files/legacy-vault-managed-documents
DOCUMENT_MAX_FILE_MB=25

# HomeBank: read-only current .xhb data and allow folder browsing beneath this root.
HOMEBANK_DIRECTORY=/home/wolf/Documents/Money
HOMEBANK_ALLOWED_ROOT=/home/wolf/Documents
HOMEBANK_PYTHON=python3
# Required: the email used to sign in to your owner vault account
HOMEBANK_OWNER_EMAIL=

# Email is opt-in. Keep false during installation, restore and acceptance review.
NOTIFICATIONS_ENABLED=false
# Required when email is enabled: independent random 64-character hex secret.
# Generate once with: openssl rand -hex 32
# Keep outside SQLite/data backups; preserve securely with the service .env.
NOTIFICATION_SECRET=
SMTP_HOST=
# 587 uses required STARTTLS; 465 requires SMTP_SECURE=true (implicit TLS).
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
# A provider-authorized sender address, separate from HOMEBANK_OWNER_EMAIL.
SMTP_FROM=
CHECKIN_REPLY_MAILBOX=
CHECKIN_IMAP_HOST=
CHECKIN_IMAP_PORT=993
CHECKIN_IMAP_USERNAME=
CHECKIN_IMAP_PASSWORD=
CHECKIN_IMAP_MAILBOX=INBOX
# Trusted receiver Authentication-Results authserv-id values, comma separated.
# Confirm that the inbound provider strips forged headers for these IDs first.
CHECKIN_TRUSTED_AUTHSERV_IDS=
# Only this timezone is supported by the five-day reminder protocol.
NOTIFICATION_TIMEZONE=Africa/Johannesburg
# Fixed by the protocol; values other than 5 are rejected.
NOTIFICATION_REMINDER_DAYS=5
EMAIL_MAX_MESSAGE_BYTES=65536
EMAIL_MAX_MESSAGES_PER_POLL=50
# Optional absolute executable path for independent operational alerts.
# The executable receives sanitized status only and must not use the mail inbox.
NOTIFICATION_ALERT_COMMAND=
