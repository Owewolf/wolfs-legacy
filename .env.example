PORT=4444

# Leave as 'auto' to generate and persist secrets automatically on first run.
# Or set your own values (JWT_SECRET: any string 32+ chars, ENCRYPTION_KEY: 64-char hex).
JWT_SECRET=auto
ENCRYPTION_KEY=auto

# Independent managed copies; choose a VERIFIED non-bind-mounted directory
DOCUMENT_STORAGE_ROOT=/srv/data/files/legacy-vault-managed-documents
DOCUMENT_MAX_FILE_MB=25

# HomeBank: read-only current .xhb data and allow folder browsing beneath this root.
HOMEBANK_DIRECTORY=/home/wolf/Documents/Money
HOMEBANK_ALLOWED_ROOT=/home/wolf/Documents
HOMEBANK_PYTHON=python3
# Required: the email used to sign in to your owner vault account
HOMEBANK_OWNER_EMAIL=
