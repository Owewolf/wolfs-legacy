{
  "name": "wolfs-vault",
  "version": "1.0.0",
  "description": "Secure personal data vault for legacy planning and estate handover",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "dev:frontend": "node scripts/dev-frontend.js",
    "jobs:run": "node scripts/run-background-jobs.js",
    "test": "node --test tests/*.test.js && PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -p 'test_homebank*.py'"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "html-to-text": "^10.0.1",
    "imapflow": "^2.9.1",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.12.4",
    "multer": "^2.0.2",
    "nodemailer": "^10.2.1"
  }
}
